# AWS credentials for local Terraform usage
# Copy this file to `config` and fill in your values:
#   cp config.example config
#
# Then load it into your shell before running Terraform:
#   source ./config
#
# Do not commit `config` — it is gitignored. Better secret management
# (IAM roles, AWS SSO, Secrets Manager, CI OIDC) will come later.

export AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
export AWS_DEFAULT_REGION="eu-west-1"

# Optional: use a named profile instead of access keys
# export AWS_PROFILE="teacher-wang"

# --- GCP (Google SSO) ----------------------------------------------------------
# Use your *personal* Google account (mazarsju@gmail.com), not a work account.
#   gcloud auth login mazarsju@gmail.com
#   gcloud config set account mazarsju@gmail.com
#   gcloud config set project teacher-wang
#   gcloud auth application-default login
# Terraform Google provider uses Application Default Credentials (ADC).
# export CLOUDSDK_CORE_ACCOUNT="mazarsju@gmail.com"
# export GOOGLE_PROJECT="teacher-wang"

# Google OAuth Web client → Cognito IdP (after module.gcp + Console checklist):
#   terraform output -raw gcp_oauth_setup_checklist
#   terraform output -raw cognito_google_redirect_uri
# export TF_VAR_cognito_google_client_id="YOUR_GOOGLE_OAUTH_CLIENT_ID"
# export TF_VAR_cognito_google_client_secret="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
# Alternative: Secrets Manager JSON {"client_id":"...","client_secret":"..."}
# export TF_VAR_cognito_google_oauth_secret_arn="arn:aws:secretsmanager:..."

# --- Backend LLM ----------------------------------------------------------------
# API key → Secrets Manager → ECS task secret LLM_API_KEY.
# Model → plain Terraform env LLM_MODEL on the backend task (default gpt-4o-mini).
# export TF_VAR_llm_api_key="YOUR_LLM_API_KEY"
# export TF_VAR_llm_model="gpt-4o-mini"
# Alternative: existing Secrets Manager plain-string secret
# export TF_VAR_llm_api_key_secret_arn="arn:aws:secretsmanager:..."
